{
  "id": "zitadel",
  "name": "ZITADEL",
  "description": "Identity and access management service for local authentication flows.",
  "enabled": true,
  "version": "2.57.0",
  "logoutput": true,
  "icon": "shield-check",
  "servicetype": 30,
  "servicelocation": 10,
  "logo": "./logo.svg",
  "logs": {
    "default": {
      "path": "./service.log"
    }
  },
  "actions": {
    "install": {
      "description": "Install or refresh the ZITADEL runtime payload."
    },
    "config": {
      "description": "Render the effective ZITADEL config."
    },
    "start": {
      "description": "Start the ZITADEL identity service."
    },
    "stop": {
      "description": "Stop the ZITADEL identity service gracefully."
    }
  },
  "endpoints": [
    {
      "id": "web",
      "kind": "network",
      "label": "Identity UI",
      "direction": "inbound",
      "transport": "tcp",
      "protocol": "http",
      "bind": "127.0.0.1",
      "port": {
        "default": 8081,
        "strategy": "preferred"
      },
      "exposure": "local",
      "required": true,
      "primary": true
    }
  ],
  "execconfig": {
    "serviceorder": 30,
    "execcwd": ".",
    "executable": "zitadel",
    "env": {
      "ZITADEL_EXTERNALDOMAIN": "localhost"
    },
    "depend_on": [
      "traefik"
    ],
    "healthchecks": [
      {
        "id": "process-ready",
        "type": "process"
      }
    ]
  }
}
