{
  "id": "secrets-broker",
  "name": "Secrets Broker",
  "description": "Secret-resolution service for provider credentials and runtime configuration.",
  "enabled": true,
  "version": "0.1.0",
  "logoutput": true,
  "icon": "key-round",
  "servicetype": 35,
  "servicelocation": 10,
  "logo": "./logo.svg",
  "logs": {
    "default": {
      "path": "./service.log"
    }
  },
  "actions": {
    "install": {
      "description": "Install or refresh the Secrets Broker runtime payload."
    },
    "config": {
      "description": "Materialize the effective secrets-broker configuration."
    },
    "start": {
      "description": "Start the Secrets Broker service."
    },
    "stop": {
      "description": "Stop the Secrets Broker gracefully."
    }
  },
  "endpoints": [
    {
      "id": "api",
      "kind": "network",
      "label": "Broker API",
      "direction": "inbound",
      "transport": "tcp",
      "protocol": "http",
      "bind": "127.0.0.1",
      "port": {
        "default": 8083,
        "strategy": "preferred"
      },
      "exposure": "local",
      "required": true,
      "primary": true
    }
  ],
  "execconfig": {
    "serviceorder": 35,
    "execcwd": ".",
    "executable": "secrets-broker",
    "env": {
      "SECRETS_PROVIDER": "local"
    },
    "depend_on": [
      "traefik"
    ],
    "healthchecks": [
      {
        "id": "process-ready",
        "type": "process"
      }
    ]
  }
}
