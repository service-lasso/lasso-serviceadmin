{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "oxc",
    "react-hooks"
  ],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-console": "error",
    "react/set-state-in-effect": "off",
    "react-hooks/exhaustive-deps": "warn"
  },
  "overrides": [
    {
      "files": ["cypress/**"],
      "rules": {
        "no-unused-expressions": "off"
      }
    }
  ],
  "env": {
    "builtin": true,
    "browser": true
  }
}
